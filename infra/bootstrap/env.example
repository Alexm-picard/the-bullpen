# /etc/default/bullpen — master env file for all bullpen systemd units.
# Copy to /etc/default/bullpen (chmod 600 root:root) and fill in the SECRET values.
# CONFIG values have sensible defaults; override only when the box differs from prod.
#
# Bootstrap: infra/bootstrap/host-bootstrap.sh reads this file and validates
# that every REQUIRED secret is non-empty before proceeding.

# ============================================================================
# SECRETS (required — the system refuses to boot or operate without these)
# ============================================================================

# Admin API credential (HTTP Basic). Format: user:password
# The app refuses to boot if empty. Prometheus scrape falls back to this
# if THEBULLPEN_METRICS_BASIC_AUTH is not set.
THEBULLPEN_ADMIN_BASIC_AUTH=

# ClickHouse password (shared by the app, docker compose, backup scripts,
# and render-users.sh). Must be the same value everywhere.
BULLPEN_CLICKHOUSE_PASSWORD=

# Grafana admin password.
GRAFANA_ADMIN_PASSWORD=

# R2 credentials (Cloudflare R2 bucket-scoped API token).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ============================================================================
# SECRETS (optional — degraded operation without these)
# ============================================================================

# Metrics-only scrape credential (F3 split). Falls back to ADMIN auth if unset.
# THEBULLPEN_METRICS_BASIC_AUTH=

# Discord webhook for app-side drift/ops alerts.
# DISCORD_WEBHOOK_URL=

# Discord webhook for backup-script failure pings (can be the same URL).
# BULLPEN_DISCORD_WEBHOOK=

# Healthchecks.io dead-man ping URLs (one per leg).
# BULLPEN_HC_PING_URL=
# BULLPEN_OFFSITE_HC_PING_URL=
# BULLPEN_REGISTRY_HC_PING_URL=

# GlitchTip/Sentry DSN (error tracking disabled if unset).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=prod

# GlitchTip Django secret key (only if errortracking docker profile is used).
# GLITCHTIP_SECRET_KEY=

# ============================================================================
# CONFIG (defaults are correct for the standard prod box layout)
# ============================================================================

# Registry DB path.
BULLPEN_REGISTRY_DB=/opt/bullpen/data/registry.sqlite

# ClickHouse connection.
BULLPEN_CLICKHOUSE_ENABLED=true
BULLPEN_CLICKHOUSE_URL=jdbc:ch:http://localhost:8123/default
BULLPEN_CLICKHOUSE_USER=default

# R2 endpoint.
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=bullpen-prod

# Offsite backup remote (rclone path). The backup scripts no-op if unset.
BULLPEN_OFFSITE_REMOTE=bullpen-r2:bullpen-prod/backups

# rclone config path (root timer context can't discover the user's config).
RCLONE_CONFIG=/home/<USER>/.config/rclone/rclone.conf

# Live ingest toggle.
BULLPEN_INGEST_LIVE_ENABLED=true

# ============================================================================
# SUPPLEMENTARY SECRETS FILE: /etc/bullpen/secrets.env
# Used by bullpen-retrain.service and bullpen-stale-claim-reaper.service.
# Derive from THEBULLPEN_ADMIN_BASIC_AUTH (split on ':').
# ============================================================================
# BULLPEN_ADMIN_USER=<user half of THEBULLPEN_ADMIN_BASIC_AUTH>
# BULLPEN_ADMIN_PASSWORD=<password half>
# CH_ADMIN_PASSWORD=<same as BULLPEN_CLICKHOUSE_PASSWORD>
